# ==============================================================================
# Nadan AI - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env.local` and substitute the placeholder values with your
# actual configuration values.
#
# Do NOT commit `.env.local` to git or expose private keys in source control.
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL or any PostgreSQL instance)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key for Vercel AI SDK (@ai-sdk/google)
# Generate your API key in Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key_here"
